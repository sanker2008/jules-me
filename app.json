{
  "expo": {
    "name": "JulesMe",
    "slug": "julesMe",
    "version": "1.1.19",
    "runtimeVersion": {
      "policy": "appVersion"
    },

    "extra": {
      "appMetadata": {
        "brand": "sanOmni",
        "author": "San"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "julesme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-ios.png",
      "buildNumber": "29"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sanomni.julesme",
      "versionCode": 29
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6656D7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "./scripts/with-android-release-signing.cjs",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow JulesMe to access your photos to attach images to tasks.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
